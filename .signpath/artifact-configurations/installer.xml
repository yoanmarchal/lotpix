<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath "installer" artifact configuration: signs the NSIS installer produced by
  cargo-packager (.github/workflows/release.yml). The GitHub artifact is a zip archive containing
  only the installer.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="lotpix_${version}_x64-setup.exe" product-name="Lotpix" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
