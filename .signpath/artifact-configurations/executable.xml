<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath "executable" artifact configuration: signs lotpix.exe before it is packaged into the
  installer (.github/workflows/release.yml). The GitHub artifact is a zip archive containing only
  lotpix.exe.

  The metadata restrictions (product name and version) are required by SignPath Foundation: they
  come from build.rs (ProductName) and Cargo.toml (version).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="lotpix.exe" product-name="Lotpix" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
